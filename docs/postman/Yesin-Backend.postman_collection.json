{
  "info": {
    "_postman_id": "b996d93e-bffb-4a86-a19f-8b2bc35a1d79",
    "name": "Yesin Backend",
    "description": "Local API checks for health and authentication. Import the matching Yesin Backend Local environment, select it, then run requests in order. The Auth smoke checks folder tests rejection and validation without SMTP or an account. Full registration and password-reset flows require SMTP configuration and a mailbox OTP.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health/live",
            "description": "Checks that the API process is running."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API is live', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness (MongoDB)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health/ready",
            "description": "Checks that MongoDB is connected. Expected status is 200."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('MongoDB and API are ready', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Registration",
      "item": [
        {
          "name": "1. Start registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"full_name\": \"{{full_name}}\",\n  \"school_name\": \"{{school_name}}\",\n  \"subject\": \"{{subject}}\",\n  \"number\": \"{{number}}\",\n  \"password\": \"{{password}}\",\n  \"confirm-password\": \"{{password}}\",\n  \"terms_accepted\": true,\n  \"device_id\": \"{{device_id}}\",\n  \"device_name\": \"{{device_name}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/register/step1",
            "description": "Validates all account fields, then sends an email OTP. Password confirmation and terms acceptance are checked before the OTP is sent."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registration details accepted and OTP sent', function () {",
                  "  pm.response.to.have.status(202);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Verify registration OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp_code\": \"{{otpCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/register/verify-otp",
            "description": "Read the 6-digit code from email or development console and set otpCode. A valid OTP creates the account and returns access/refresh tokens."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('OTP verified and account created', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.user.id).to.be.a('string');",
                  "  pm.environment.set('accessToken', body.data.tokens.access_token);",
                  "  pm.environment.set('refreshToken', body.data.tokens.refresh_token);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"remember_me\": true,\n  \"device_id\": \"{{device_id}}\",\n  \"device_name\": \"{{device_name}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Saves accessToken and refreshToken automatically."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login successful and tokens received', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('accessToken', body.data.tokens.access_token);",
                  "  pm.environment.set('refreshToken', body.data.tokens.refresh_token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/auth/me",
            "description": "Requires accessToken from registration or login."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Authenticated user returned', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.user.email).to.eql(pm.environment.get('email'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh tokens",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/refresh",
            "description": "Rotates refreshToken and saves both newly issued tokens. Reusing an old refresh token revokes that session."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Tokens refreshed and rotated', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('accessToken', body.data.access_token);",
                  "  pm.environment.set('refreshToken', body.data.refresh_token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/logout",
            "description": "Revokes the session and clears the local tokens after a successful response."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logged out', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.environment.unset('accessToken');",
                  "  pm.environment.unset('refreshToken');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Password reset",
      "item": [
        {
          "name": "1. Request password reset OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/password/forgot",
            "description": "Requests a reset code. The response is intentionally generic to prevent account enumeration."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Password reset request accepted', function () {",
                  "  pm.response.to.have.status(202);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Reset password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp_code\": \"{{otpCode}}\",\n  \"new_password\": \"{{newPassword}}\",\n  \"confirm_password\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/password/reset",
            "description": "Set otpCode to the password-reset code received by email. Password reset revokes all active sessions."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Password reset successful', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.environment.unset('accessToken');",
                  "  pm.environment.unset('refreshToken');",
                "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"purpose\": \"email_verification\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/resend-otp",
            "description": "Use purpose email_verification or password_reset. Resend is rate limited."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('OTP resend request accepted', function () {",
                  "  pm.response.to.have.status(202);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth smoke checks (no SMTP required)",
          "item": [
            {
              "name": "Reject unknown test-account login",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{smokeEmail}}\",\n  \"password\": \"NotAValidAccount123!\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{baseUrl}}/api/v1/auth/login",
                "description": "Uses a reserved .invalid email domain; expects generic invalid credentials and does not create an account."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Unknown credentials are rejected safely', function () {",
                      "  pm.response.to.have.status(401);",
                      "  pm.expect(pm.response.json().error.code).to.eql('INVALID_CREDENTIALS');",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Reject unauthenticated current-user request",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/api/v1/auth/me",
                "description": "Expects 401 because no bearer token is supplied."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Protected endpoint requires authentication', function () {",
                      "  pm.response.to.have.status(401);",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Reject unknown refresh token",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refresh_token\": \"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{baseUrl}}/api/v1/auth/refresh",
                "description": "Expects 401 for a correctly shaped but unrecognized refresh token."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Unknown refresh tokens are rejected', function () {",
                      "  pm.response.to.have.status(401);",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Reject malformed login email",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"AnyPassword123!\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{baseUrl}}/api/v1/auth/login",
                "description": "Expects 400 with a structured validation error."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Malformed login input is rejected', function () {",
                      "  pm.response.to.have.status(400);",
                      "  pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR');",
                      "});"
                    ]
                  }
                }
              ]
            }
      ]
    }
  ]
}
