NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/yesin-backend
LOG_LEVEL=info
CORS_ORIGIN=
TRUST_PROXY_HOPS=0
JWT_ACCESS_SECRET=replace-with-a-random-32-character-or-longer-secret
OTP_PEPPER=replace-with-a-different-random-32-character-pepper
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
LOG_OTP_TO_CONSOLE=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=yesin-app
